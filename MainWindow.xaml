<Window x:Class="NSCheatManager.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:NSCheatManager.Windows.Controls" Title="NS Cheat Manager" Icon="Assets/app.png" Width="800" Height="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#F7F8FC" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#2764D8"/><SolidColorBrush x:Key="Line" Color="#D8DEEA"/><SolidColorBrush x:Key="Muted" Color="#616B80"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14"/></Style>
  <Style x:Key="Button" TargetType="Button"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,3"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C7CEDC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Button}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Button}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,2"/></Style>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="7,3"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,0"><DockPanel VerticalAlignment="Center" LastChildFill="False"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Border Width="28" Height="28" Background="{StaticResource Accent}" CornerRadius="7"><controls:LucideIcon Kind="Gamepad" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="NS Cheat Manager" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PinButton" Style="{StaticResource Button}" Content="置顶" Click="PinButton_Click"/><Button x:Name="LanguageButton" Margin="8,0,0,0" Style="{StaticResource Button}" Content="中文 / EN" Click="LanguageButton_Click"/><Button x:Name="VersionButton" Style="{StaticResource Button}" Content="v1.0.0  ⓘ" Click="VersionButton_Click" Margin="8,0,0,0"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#F0F3F9" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12"><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Top"><Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10"><StackPanel><TextBlock x:Name="DeviceLabel" Text="要连接的设备" Foreground="{StaticResource Muted}"/><Border CornerRadius="7" BorderBrush="#C7CEDC" BorderThickness="1" Background="White" Margin="0,5,0,0"><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" BorderThickness="0" Background="Transparent"/></Border><TextBlock Text="{Binding SelectedDevice.EndpointSummary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="{Binding ConnectionStatus}" Foreground="{Binding ConnectionStatusBrush}" Margin="0,4,0,0"/></StackPanel></Border><Button x:Name="GameNav" Style="{StaticResource Nav}" Background="{Binding GameNavBackground}" Foreground="{Binding GameNavForeground}" Command="{Binding NavigateGameCommand}"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="Gamepad" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="GameNavLabel" Text="游戏信息" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="CheatsNav" Style="{StaticResource Nav}" Background="{Binding CheatsNavBackground}" Foreground="{Binding CheatsNavForeground}" Command="{Binding NavigateCheatsCommand}"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="Code" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="CheatsNavLabel" Text="金手指" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="FtpNav" Style="{StaticResource Nav}" Background="{Binding FtpNavBackground}" Foreground="{Binding FtpNavForeground}" Command="{Binding NavigateFilesCommand}"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="Files" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="FtpNavLabel" Text="FTP 功能" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="DatabaseNav" Style="{StaticResource Nav}" Background="{Binding LibraryNavBackground}" Foreground="{Binding LibraryNavForeground}" Command="{Binding NavigateLibraryCommand}"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="Database" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="DatabaseNavLabel" Text="本地数据库" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="ScreenNav" Style="{StaticResource Nav}" Background="{Binding ScreensNavBackground}" Foreground="{Binding ScreensNavForeground}" Command="{Binding NavigateScreensCommand}"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="Camera" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="ScreenNavLabel" Text="截图与屏幕" VerticalAlignment="Center"/></StackPanel></Button></StackPanel><Button x:Name="SettingsNav" DockPanel.Dock="Bottom" Style="{StaticResource Nav}" Background="{Binding SettingsNavBackground}" Foreground="{Binding SettingsNavForeground}" Command="{Binding NavigateSettingsCommand}"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="Settings" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="SettingsNavLabel" Text="设置" VerticalAlignment="Center"/></StackPanel></Button></DockPanel></Border>
   <Grid Grid.Column="1" Margin="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsGamePageVisible}"><StackPanel><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="GameTitle" Text="游戏信息" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="GameSubtitle" Text="默认通过 sys-botbase 建立设备会话" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ConnectButton" Style="{StaticResource Primary}" Content="连接" Command="{Binding ConnectCommand}"/><Button x:Name="DisconnectButton" Style="{StaticResource Button}" Content="断开" Command="{Binding DisconnectCommand}" Margin="8,0,0,0"/></StackPanel></DockPanel><Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><DockPanel LastChildFill="True" Margin="0,3"><TextBlock Text="Title ID" Width="110" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding TitleId}" FontFamily="Consolas"/></DockPanel><DockPanel LastChildFill="True" Margin="0,7,0,3"><TextBlock Text="Build ID" Width="110" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding BuildId}" FontFamily="Consolas"/></DockPanel><DockPanel LastChildFill="True" Margin="0,7,0,3"><TextBlock Text="Main Base" Width="110" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding MainBase}" FontFamily="Consolas"/></DockPanel><DockPanel LastChildFill="True" Margin="0,7,0,3"><TextBlock Text="Heap Base" Width="110" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding HeapBase}" FontFamily="Consolas"/></DockPanel><DockPanel LastChildFill="True" Margin="0,7,0,3"><TextBlock Text="dmnt" Width="110" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding DmntStatus}"/></DockPanel></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="SessionOps" Text="会话操作" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="DetachButton" Style="{StaticResource Button}" Content="分离 dmnt" Command="{Binding DetachDmntCommand}"/><Button x:Name="GoFtpButton" Style="{StaticResource Button}" Content="打开 FTP 功能" Command="{Binding NavigateFilesCommand}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></StackPanel></ScrollViewer>
      <Grid Visibility="{Binding IsCheatsPageVisible}">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel><TextBlock x:Name="CheatsTitle" Text="金手指" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="CheatsSubtitle" Text="点击后自动识别并连接，仅显示当前 BID.txt 与 notes.txt" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding CheatFtpStatus}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
       <WrapPanel Grid.Row="1" Margin="0,8,0,0"><Button x:Name="DownloadCheatButton" Style="{StaticResource Button}" Content="从 Switch 下载金手指" Command="{Binding DownloadCommand}" ToolTip="自动连接 sys-botbase 与 FTP，并只列出当前 BID.txt 和 notes.txt"/><Button x:Name="SaveCheatToDatabaseButton" Style="{StaticResource Button}" Content="写入数据库" Command="{Binding SaveToDatabaseCommand}" ToolTip="必须先连接并识别游戏；点击后填写备注，才会写入本地数据库" Margin="6,0,0,0"/><Button x:Name="ImportZipButton" Style="{StaticResource Button}" Content="导入 ZIP" Command="{Binding ImportZipCommand}" Margin="6,0,0,0"/><Button x:Name="ExportZipButton" Style="{StaticResource Primary}" Content="打包为 ZIP" Command="{Binding ExportZipCommand}" Margin="6,0,0,0"/></WrapPanel>
       <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" Margin="0,10,0,10"><DockPanel><Button x:Name="CheatBackButton" DockPanel.Dock="Left" Style="{StaticResource Button}" Content="← 上级" Command="{Binding GoCheatParentCommand}" Visibility="Collapsed"/><TextBox Text="{Binding CheatRemotePath, Mode=OneWay}" IsReadOnly="True"/></DockPanel></Border>
       <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8"><DataGrid x:Name="CheatGrid" ItemsSource="{Binding CheatEntries}" SelectedItem="{Binding SelectedCheatEntry}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" MouseDoubleClick="CheatGrid_MouseDoubleClick" PreviewMouseRightButtonDown="RemoteGrid_PreviewMouseRightButtonDown"><DataGrid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem x:Name="CheatDownloadMenuItem" Header="下载" Command="{Binding DownloadCheatEntryCommand}" CommandParameter="{Binding SelectedCheatEntry}"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="140"/></DataGrid.Columns></DataGrid></Border>
      </Grid>

    <Grid Visibility="{Binding IsFilesPageVisible}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="FtpTitle" Text="FTP 功能" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding FtpStatus}" Foreground="{StaticResource Muted}"/></StackPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="ListTextButton" Style="{StaticResource Button}" Content="{Binding ConnectionButtonText}" Command="{Binding ToggleConnectionCommand}"/><Button x:Name="ListAllButton" Style="{StaticResource Primary}" Content="列出全部文件" Command="{Binding ListAllFilesCommand}" Margin="6,0,0,0"/></WrapPanel></DockPanel>
     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,12,0,10"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="NewFolderButton" Style="{StaticResource Button}" Content="新建文件夹" Command="{Binding CreateFolderCommand}"/></StackPanel><Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource Button}" Content="← 上级" Command="{Binding GoParentCommand}"/><TextBox Text="{Binding RemotePath}" Margin="8,0" IsReadOnly="True"/></DockPanel></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" AllowDrop="True" Drop="RemotePanel_Drop" DragOver="RemotePanel_DragOver"><DataGrid x:Name="RemoteGrid" ItemsSource="{Binding RemoteEntries}" SelectedItem="{Binding SelectedRemoteEntry}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" MouseDoubleClick="RemoteGrid_MouseDoubleClick" PreviewMouseRightButtonDown="RemoteGrid_PreviewMouseRightButtonDown"><DataGrid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem x:Name="DownloadMenuItem" Header="下载" Command="{Binding DownloadEntryCommand}" CommandParameter="{Binding SelectedRemoteEntry}"/><MenuItem x:Name="RenameMenuItem" Header="重命名" Command="{Binding RenameEntryCommand}" CommandParameter="{Binding SelectedRemoteEntry}"/><Separator/><MenuItem x:Name="DeleteMenuItem" Header="删除" Foreground="#A21728" Command="{Binding DeleteEntryCommand}" CommandParameter="{Binding SelectedRemoteEntry}"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="140"/></DataGrid.Columns></DataGrid></Border>
     <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" BorderBrush="#9DB7E8" AllowDrop="True" Drop="RemotePanel_Drop" DragOver="RemotePanel_DragOver"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="DropTitle" Text="拖放一个或多个文件到这里" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="DropHelp" Text="只加入待确认区，不会自动上传；不接受文件夹" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Background="#FFF9EF" BorderBrush="#EDCF99" Margin="10,0,0,0"><DockPanel><StackPanel DockPanel.Dock="Bottom"><Button x:Name="ConfirmUploadButton" Style="{StaticResource Primary}" Content="确认上传全部" Command="{Binding UploadAllCommand}"/><TextBlock Text="{Binding TransferStatus}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding VisiblePendingUploads}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#EDCF99" BorderThickness="0,0,0,1" Padding="0,6"><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Button}" Content="移除" Command="{Binding DataContext.RemovePendingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding EffectiveRemotePath}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border></Grid>
    </Grid>

    <Grid Visibility="{Binding IsLibraryPageVisible}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel>
        <StackPanel><TextBlock x:Name="DatabaseTitle" Text="本地数据库" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="DatabaseSubtitle" Text="手动写入、离线编辑和恢复历史版本" Foreground="{StaticResource Muted}"/></StackPanel>
        <WrapPanel Margin="0,8,0,0">
          <Button x:Name="SaveToDatabaseButton" Style="{StaticResource Primary}" Content="写入数据库" Command="{Binding SaveToDatabaseCommand}" ToolTip="读取当前识别游戏的 BID.txt 与 notes.txt，仅保存到本地数据库，不会上传到 Switch"/>
          <Button Style="{StaticResource Button}" Content="刷新" Command="{Binding RefreshHistoryCommand}" Margin="6,0,0,0"/>
          <Button x:Name="OpenDataButton" Style="{StaticResource Button}" Content="打开 data 目录" Command="{Binding OpenDataFolderCommand}" Margin="6,0,0,0"/>
        </WrapPanel>
      </StackPanel>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="游戏名称设置" FontSize="16" FontWeight="SemiBold"/>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,6,8"><TextBlock Text="TID" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding DatabaseTitleId, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,8"><TextBlock Text="游戏名" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding DatabaseGameName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" ToolTip="例如：宝可梦朱紫"/></StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,6,0"><TextBlock Text="BID" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding DatabaseBuildId, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="版本名" Foreground="{StaticResource Muted}"/><DockPanel><Button x:Name="SaveDatabaseLabelsButton" DockPanel.Dock="Right" Style="{StaticResource Button}" Content="保存名称" Command="{Binding SaveDatabaseLabelsCommand}" Margin="6,0,0,0"/><TextBox Text="{Binding DatabaseVersionName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" ToolTip="例如：版本 v4.0.0"/></DockPanel></StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" Margin="0,12,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="EditSelectedHistoryButton" Style="{StaticResource Button}" Content="离线编辑" Command="{Binding EditHistoryCommand}"/><Button x:Name="SaveSelectedHistoryEditButton" Style="{StaticResource Button}" Content="保存编辑" Command="{Binding SaveHistoryEditCommand}" Margin="6,0,0,0"/><Button x:Name="RestoreSelectedHistoryButton" Style="{StaticResource Primary}" Content="恢复并上传" Command="{Binding RestoreHistoryCommand}" Margin="6,0,0,0"/></StackPanel>
            <TextBlock Text="{Binding SelectedHistorySummary}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,8,0"/>
          </DockPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryEntries}" SelectedItem="{Binding SelectedHistoryEntry}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" HeadersVisibility="Column" RowHeaderWidth="0" HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
              <DataGridTextColumn Header="游戏 / TID" Binding="{Binding TitleDisplay}" Width="135"/>
              <DataGridTextColumn Header="版本 / BID" Binding="{Binding BuildDisplay}" Width="135"/>
              <DataGridTextColumn Header="文件" Binding="{Binding FileDisplay}" Width="80"/>
              <DataGridTemplateColumn Header="备注" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Remark}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Remark}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Visibility="{Binding IsScreensPageVisible}"><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="ScreensTitle" Text="截图与屏幕" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ScreensSubtitle" Text="文件名留空时使用当前时间戳" Foreground="{StaticResource Muted}"/></StackPanel><Button x:Name="OpenScreensButton" DockPanel.Dock="Right" Style="{StaticResource Button}" Content="打开截图目录" Command="{Binding OpenScreenshotsFolderCommand}"/></DockPanel><Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="CaptureTitle" Text="截取屏幕" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Grid Width="420"><TextBox Text="{Binding ScreenshotName, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 gameplay；留空使用 yyyyMMdd-HHmmss"/><TextBlock Text="请输入要保存的文件名" Foreground="#8A93A5" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ScreenshotName}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ScreenshotName}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button x:Name="CaptureButton" Style="{StaticResource Primary}" Content="截图" Command="{Binding ScreenshotCommand}" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="ScreenOnButton" Style="{StaticResource Button}" Content="亮屏" Command="{Binding ScreenOnCommand}"/><Button x:Name="ScreenOffButton" Style="{StaticResource Button}" Content="熄屏" Command="{Binding ScreenOffCommand}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></StackPanel>

     <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettingsPageVisible}"><StackPanel MaxWidth="780"><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="SettingsTitle" Text="设置" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SettingsSubtitle" Text="每台设备分别保存名称、IPv4 和协议端口" Foreground="{StaticResource Muted}"/></StackPanel><Button x:Name="SaveSettingsButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" MinWidth="96" HorizontalAlignment="Right" Content="保存设置" Command="{Binding SaveDeviceCommand}"/></DockPanel><Border Style="{StaticResource Card}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,8,10"><TextBlock Text="设备名称"/><TextBox Text="{Binding SelectedDevice.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="设备 IPv4"/><TextBox Text="{Binding SelectedDevice.Host, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="1" Margin="0,0,8,10"><TextBlock Text="sys-botbase 端口"/><TextBox Text="{Binding SelectedDevice.SysBotbasePort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="FTP 端口"/><TextBox Text="{Binding SelectedDevice.FtpPort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="2" Margin="0,0,8,10"><TextBlock Text="Noexs 端口"/><TextBox Text="{Binding SelectedDevice.NoexsPort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><CheckBox Grid.Row="2" Grid.Column="1" Content="连接前自动分离 dmnt" IsChecked="{Binding SelectedDevice.AutoDetachDmnt}" VerticalAlignment="Center" Margin="8,10,0,0"/><StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Text="TXT 文本编辑器路径（留空使用系统关联）"/><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Button}" Content="浏览…" Click="BrowseEditor_Click" Margin="8,0,0,0"/><TextBox Text="{Binding SelectedDevice.TextEditorPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel><DockPanel Grid.Row="4" Grid.ColumnSpan="2" LastChildFill="False"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Style="{StaticResource Button}" Content="新增设备" Command="{Binding AddDeviceCommand}"/><Button Style="{StaticResource Button}" Content="删除此设备" Foreground="#A21728" Command="{Binding DeleteDeviceCommand}" Margin="8,0,0,0"/></StackPanel><Button x:Name="OpenLogsButton" DockPanel.Dock="Right" Style="{StaticResource Button}" Content="打开日志文件夹" Command="{Binding OpenLogsFolderCommand}" ToolTip="data\logs"/></DockPanel></Grid></Border></StackPanel></ScrollViewer>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,0"><TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessageBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border>
 </Grid>
</Window>
